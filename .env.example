# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Server / transport -----------------------------------------------
MCP_HOST=127.0.0.1
MCP_PORT=8765
MCP_TRANSPORT=stdio        # stdio | sse
LOG_LEVEL=INFO

# --- Colab / runtime -----------------------------------------------------
# There is no single global connection file: each session picks its own
# provider ("colab" | "local_jupyter" | "remote_jupyter" | "docker") and
# provider_config via the colab_create_session tool. See docs/RUNTIME_PROVIDERS.md
# and docs/COLAB.md. COLAB_AUTH_MODE only matters if REQUIRE_AUTH=true (see below).
COLAB_AUTH_MODE=none        # none | api_key | google_oauth | service_account (see docs/AUTHENTICATION.md)
COLAB_TIMEOUT=120
MAX_CONCURRENT_JOBS=4
COLAB_REMOTE_WORKSPACE_ROOT=/content/mcp_workspace

# --- Health monitoring / reconnect --------------------------------------
HEALTH_MONITOR_ENABLED=true
HEALTH_CHECK_INTERVAL_SECONDS=30
MAX_RECONNECT_ATTEMPTS=3

# --- Security --------------------------------------------------------
# MCP_AUTH_TOKEN is only used when REQUIRE_AUTH=true and COLAB_AUTH_MODE=api_key.
REQUIRE_AUTH=false
MCP_AUTH_TOKEN=
COLAB_WORKSPACE_ROOT=./workspace
ALLOWED_TOOLS=
DENIED_TOOLS=
MAX_REQUESTS_PER_MINUTE=60
MAX_CODE_LENGTH=200000
AUDIT_LOG_PATH=./logs/audit.log

# Dangerous-tool confirmation: when true, tools on security/dangerous_tools.py's
# list (colab_execute_code, colab_delete_file, colab_restart_runtime, ...) must
# be called with {"confirm": true}, or they're refused.
DANGEROUS_TOOLS_REQUIRE_CONFIRM=false
MAX_OUTPUT_BYTES=2000000
MAX_FILE_SIZE_BYTES=100000000

# --- Artifacts / environments / datasets --------------------------------
COLAB_ARTIFACT_ROOT=./workspace/artifacts
COLAB_NOTEBOOK_ROOT=./workspace/notebooks
COLAB_ENVIRONMENT_ROOT=./workspace/environments
COLAB_DATASET_ROOT=./workspace/datasets
