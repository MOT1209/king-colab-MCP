# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Server / transport -----------------------------------------------
MCP_HOST=127.0.0.1
MCP_PORT=8765
MCP_TRANSPORT=stdio        # stdio | sse
LOG_LEVEL=INFO

# --- Colab / runtime -----------------------------------------------------
# Leave COLAB_KERNEL_CONNECTION_FILE unset to launch a local Jupyter kernel
# (useful for development). Set it to attach to a real Colab/Jupyter kernel
# gateway's connection file to control an actual remote runtime.
COLAB_AUTH_MODE=none        # none | api_key | google_oauth | service_account
COLAB_KERNEL_CONNECTION_FILE=
COLAB_TIMEOUT=120
MAX_CONCURRENT_JOBS=4
COLAB_REMOTE_WORKSPACE_ROOT=/content/mcp_workspace

# --- Security --------------------------------------------------------
# MCP_AUTH_TOKEN is only used when REQUIRE_AUTH=true and COLAB_AUTH_MODE=api_key.
REQUIRE_AUTH=false
MCP_AUTH_TOKEN=
COLAB_WORKSPACE_ROOT=./workspace
ALLOWED_TOOLS=
DENIED_TOOLS=
MAX_REQUESTS_PER_MINUTE=60
MAX_CODE_LENGTH=200000
AUDIT_LOG_PATH=./logs/audit.log

# --- Artifacts ---------------------------------------------------------
COLAB_ARTIFACT_ROOT=./workspace/artifacts
COLAB_NOTEBOOK_ROOT=./workspace/notebooks
